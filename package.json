{
  "name": "@joltsms/mcp-server",
  "version": "2.0.3",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "mcpName": "io.github.rchanllc/joltsms-sms",
  "description": "MCP server for JoltSMS \u2014 provision real-SIM phone numbers and receive OTP codes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rchanllc/joltsms-mcp-server.git"
  },
  "homepage": "https://joltsms.com/developers/mcp",
  "keywords": [
    "mcp",
    "sms",
    "otp",
    "phone-number",
    "verification",
    "model-context-protocol",
    "joltsms",
    "ai-agent"
  ],
  "bin": {
    "mcp-server": "./dist/server.js",
    "joltsms-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "zod"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node --test test/distribution/*.test.mjs",
    "test:gate": "npm run build && node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:package",
    "release:publish": "npm publish . --ignore-scripts --access public --tag latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
